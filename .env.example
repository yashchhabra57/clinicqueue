# Copy to .env (never commit .env). Values here are read by docker compose and by
# ASP.NET Core as environment variables (double underscore = nested config key).

# Shared front-desk key sent in the X-Staff-Key header. Required outside Development.
STAFF_API_KEY=change-me

# Sqlite (default) or Postgres
Database__Provider=Sqlite
ConnectionStrings__ClinicQueue=Data Source=clinicqueue.db
# ConnectionStrings__ClinicQueue=Host=localhost;Database=clinicqueue;Username=postgres;Password=postgres

# Seed a demo clinic with four weeks of synthetic history on first start.
Seed__Demo=true

# Seconds between background board refreshes (0 disables).
Board__TickSeconds=30
